# Copy this template to apps/api/.env and fill in the required values.
# The API loads that file automatically; shell and process-manager values win.
# Set IMS_ENV_FILE in the launching process to use another file; an empty value disables loading.
# Never commit a populated .env file or a real secret.
NODE_ENV=production
IMS_BACKOFFICE_JWT_SECRET=
# Independent Platform realm signing secret. Production requires at least 32
# UTF-8 bytes and rejects reuse of either Backoffice verification secret.
IMS_PLATFORM_JWT_SECRET=
# Platform registration verification email. Development defaults to console
# when this mode is unset. Production rejects console and must use Cloudflare
# Email Service with every value below configured.
IMS_PLATFORM_EMAIL_DELIVERY=cloudflare
IMS_CLOUDFLARE_EMAIL_ACCOUNT_ID=
IMS_CLOUDFLARE_EMAIL_API_TOKEN=
# Use an address from a sender domain onboarded in Cloudflare Email Service.
IMS_PLATFORM_EMAIL_FROM=
IMS_PLATFORM_EMAIL_FROM_NAME=IMSWeb
# Keep the previous Backoffice secret only during the documented rolling
# compatibility window. New deployments must not use this as their primary secret.
# IMS_JWT_SECRET=
IMS_COOKIE_SECURE=true
# On the first role-enabled production startup, set an existing op username.
IMS_SUPER_ADMIN_USERNAME=

# Bind to loopback when an external reverse proxy runs on the same host. A direct
# deployment must choose an address and network policy appropriate for its ingress.
HOST=127.0.0.1
PORT=3000
IMS_CLIENT_ADDRESS_SOURCE=direct
# Keep discovery hidden until media publication, location privacy review, and
# reconciliation are complete.
IMS_FUDABA_PUBLIC_READ_ENABLED=false
# Keep authenticated profile/card mutations independently disabled until moderation is ready.
IMS_FUDABA_WRITE_ENABLED=false
# Keep the privacy-reviewed public office map independently disabled. The bundled
# style and province GeoJSON are served from this application origin only.
IMS_FUDABA_MAP_ENABLED=false
IMS_FUDABA_MAP_STYLE_URL=/maps/exchange-style.json

# Mutable media storage. The AWS SDK uses its standard credential provider
# chain; prefer an instance/task role over long-lived access keys.
IMS_OBJECT_STORAGE=s3
IMS_S3_BUCKET=
IMS_PUBLIC_READ_URL_BASE=
IMS_S3_REGION=
IMS_S3_ENDPOINT=
IMS_S3_FORCE_PATH_STYLE=false
IMS_S3_PREFIX=
IMS_S3_READ_URL_TTL_SECONDS=300
# IMS_S3_PREFIX is optional. When set, it appears after the bucket/base URL and
# before the semantic object path.
# Production R2 convention: IMS_S3_BUCKET=imsweb-media-prod and
# IMS_S3_PREFIX is empty. The custom domain must block /__protected/*.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Local RustFS started by `pnpm run dev:rustfs:up`:
# IMS_OBJECT_STORAGE=s3
# IMS_S3_BUCKET=imsweb-media-local
# IMS_PUBLIC_READ_URL_BASE=http://127.0.0.1:9000/imsweb-media-local
# IMS_S3_REGION=us-east-1
# IMS_S3_ENDPOINT=http://127.0.0.1:9000
# IMS_S3_FORCE_PATH_STYLE=true
# IMS_S3_PREFIX=
# IMS_S3_READ_URL_TTL_SECONDS=300
# AWS_ACCESS_KEY_ID=imsweb-local
# AWS_SECRET_ACCESS_KEY=imsweb-local-password

# Same-host production RustFS behind the host-installed Nginx template. The
# public base includes the bucket; the endpoint does not. Both must use the
# browser-reachable object hostname because private reads use signed URLs.
# IMS_S3_BUCKET=imsweb-media-prod
# IMS_PUBLIC_READ_URL_BASE=https://objects.example.com/imsweb-media-prod
# IMS_S3_REGION=us-east-1
# IMS_S3_ENDPOINT=https://objects.example.com
# IMS_S3_FORCE_PATH_STYLE=true
# IMS_S3_PREFIX=
# IMS_S3_READ_URL_TTL_SECONDS=300

# Cloudflare R2 through its S3-compatible API. The public read URL must be the
# custom domain attached directly to IMS_S3_BUCKET.
# IMS_S3_BUCKET=imsweb-media-prod
# IMS_PUBLIC_READ_URL_BASE=https://imas-assets.texasoct.tech
# IMS_S3_REGION=auto
# IMS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# IMS_S3_FORCE_PATH_STYLE=false
# IMS_S3_PREFIX=
# Cloudflare WAF must block paths containing /__protected/ on the custom domain.

# One instance always uses one physical PostgreSQL database and one shared pool.
DATABASE_URL=
IMS_PG_POOL_MAX=10
IMS_PG_IDLE_TIMEOUT_MS=30000
IMS_PG_CONNECTION_TIMEOUT_MS=5000
IMS_PG_STATEMENT_TIMEOUT_MS=30000
IMS_PG_IDLE_TRANSACTION_TIMEOUT_MS=30000

# These local paths assume IMS_PROJECT_ROOT is the repository root. S3 mode
# persists compensation in the SQL database, so IMS_COMPENSATION_DIR is used
# only by filesystem object storage. Production
# must use absolute paths under /srv/ims/shared and point
# IMS_PUBLIC_DIR at the active release's apps/api/dist/node-client directory.
IMS_COMPENSATION_DIR=./data/core/compensation
IMS_IDEMPOTENCY_DIR=./data/core/idempotency
IMS_PUBLIC_DIR=./apps/api/dist/node-client
IMS_UPLOADS_DIR=./data/uploads
IMS_EVENT_BASE_DIR=./data/chronicle
IMS_STORY_DATA_DIR=./data/story/images
IMS_STORY_MAX_UPLOAD_BYTES=52428800
IMS_SITE_PACKAGE_MAX_UPLOAD_BYTES=26214400

# IMS_INFORMATION_SOURCE_DIR=./data/import/public

# One-shot account administration. Leave passwords unset except in the shell
# that executes the corresponding apps/api operation command.
IMS_NEW_USER_USERNAME=
IMS_NEW_USER_PASSWORD=
IMS_NEW_USER_DEPT=editor
IMS_NEW_USER_PRODUCER_NAME=
IMS_PASSWORD_TO_HASH=
